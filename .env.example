# Copy this file to .env, then replace the placeholder locally.
# Never commit or share your real key.
APP_NAME=Smart AI Support API
OPENAI_API_KEY=your_openai_api_key_here

# auto: OpenAI when a real key exists, otherwise local Ollama.
# You can also force openai or ollama explicitly.
LLM_PROVIDER=auto

# native uses the project's direct OpenAI/Ollama adapters. langchain uses the
# optional LangChain model adapter and requires Python 3.10+.
LLM_ORCHESTRATOR=native

# Local PostgreSQL development database. Replace these credentials in any
# shared or deployed environment.
POSTGRES_DB=llm_gateway
POSTGRES_USER=llm_gateway
POSTGRES_PASSWORD=llm_gateway_local
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://llm_gateway:llm_gateway_local@127.0.0.1:5432/llm_gateway
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
BUSINESS_DATA_DIR=Business_data
KNOWLEDGE_BASE_DIR=Knowledge Base
RAG_EMBEDDING_PROVIDER=ollama
RAG_EMBEDDING_DIMENSIONS=768
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200
RAG_RETRIEVAL_K=5
GRAPHRAG_GUARDRAIL_TIMEOUT_SECONDS=90
GRAPHRAG_GUARDRAIL_MIN_CONFIDENCE=0.75

# Real Microsoft GraphRAG lives in an isolated runtime and a reviewed local index.
MICROSOFT_GRAPHRAG_ENABLED=false
MICROSOFT_GRAPHRAG_ROOT=.local/graphrag-ms-business-v1
MICROSOFT_GRAPHRAG_PYTHON=.venv-graphrag/bin/python
MICROSOFT_GRAPHRAG_TIMEOUT_SECONDS=90

# Optional Neo4j branch. .env.neo4j overrides these local settings when present.
# Use a database-enforced read-only principal in production. The Community
# development recipe instead makes the whole business database read-only.
NEO4J_ENABLED=false
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_DATASET=aster-business-v1
NEO4J_QUERY_TIMEOUT_SECONDS=10
NEO4J_PLAN_TIMEOUT_SECONDS=60
NEO4J_MAX_ESTIMATED_ROWS=100000
# MapReduce answer generation has its own overall budget after retrieval.
GRAPH_ANSWER_TIMEOUT_SECONDS=120
NEO4J_LOAD_USER=
NEO4J_LOAD_PASSWORD=

# Optional Snowflake OLAP backend. Keep credentials only in the local .env file.
# PostgreSQL remains the conversation database when Snowflake is enabled.
SNOWFLAKE_ENABLED=false
# Default business analytics stay on Neo4j. To select Snowflake, set BOTH
# SNOWFLAKE_ENABLED=true and ANALYTICS_BACKEND=snowflake after verifying its data.
ANALYTICS_BACKEND=neo4j
SNOWFLAKE_ACCOUNT=your_org-your_account
SNOWFLAKE_USER=your_user
SNOWFLAKE_AUTH_METHOD=key_pair
SNOWFLAKE_PRIVATE_KEY_FILE=.local/snowflake/rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=replace_with_your_local_key_passphrase
# Used only when SNOWFLAKE_AUTH_METHOD=password and allowed by account policy.
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=SMART_AI_WH
SNOWFLAKE_DATABASE=SMART_AI_ANALYTICS
SNOWFLAKE_SCHEMA=ECOMMERCE
SNOWFLAKE_ROLE=SMART_AI_ANALYST
# Loading uses a separate .env.snowflake-loader file, never the assistant identity.
SNOWFLAKE_LOAD_ROLE=
SNOWFLAKE_POOL_SIZE=2
SNOWFLAKE_MAX_OVERFLOW=3
SNOWFLAKE_TIMEOUT_SECONDS=30
OPENAI_CHAT_MODEL=gpt-5.6-luna
OPENAI_REASON_MODEL=gpt-5.6-terra
OPENAI_RECOMMENDATION_MODEL=gpt-5.6-terra
OPENAI_VISION_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_VISION_DETAIL=high
VISION_MAX_IMAGE_BYTES=10485760
OPENAI_REASONING_EFFORT=medium
OPENAI_TIMEOUT_SECONDS=60

# Local Ollama provider settings (no API key required).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_REASON_MODEL=qwen3:4b
OLLAMA_RECOMMENDATION_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=embeddinggemma
OLLAMA_CHAT_THINK=true
OLLAMA_KEEP_ALIVE=5m
OLLAMA_TIMEOUT_SECONDS=300
