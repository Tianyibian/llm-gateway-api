# Copy this file to .env, then replace the placeholder locally.
# Never commit or share your real key.
APP_NAME=Smart AI Support API
OPENAI_API_KEY=your_openai_api_key_here

# auto: OpenAI when a real key exists, otherwise local Ollama.
# You can also force openai or ollama explicitly.
LLM_PROVIDER=auto

# native uses the project's direct OpenAI/Ollama adapters. langchain uses the
# optional LangChain model adapter and requires Python 3.10+.
LLM_ORCHESTRATOR=native

# Local PostgreSQL development database. Replace these credentials in any
# shared or deployed environment.
POSTGRES_DB=llm_gateway
POSTGRES_USER=llm_gateway
POSTGRES_PASSWORD=llm_gateway_local
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://llm_gateway:llm_gateway_local@127.0.0.1:5432/llm_gateway
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
BUSINESS_DATA_DIR=Business_data
KNOWLEDGE_BASE_DIR=Knowledge Base
RAG_EMBEDDING_PROVIDER=ollama
RAG_EMBEDDING_DIMENSIONS=768
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200
RAG_RETRIEVAL_K=5
OPENAI_CHAT_MODEL=gpt-5.6-luna
OPENAI_REASON_MODEL=gpt-5.6-terra
OPENAI_RECOMMENDATION_MODEL=gpt-5.6-terra
OPENAI_VISION_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_VISION_DETAIL=high
VISION_MAX_IMAGE_BYTES=10485760
OPENAI_REASONING_EFFORT=medium
OPENAI_TIMEOUT_SECONDS=60

# Local Ollama provider settings (no API key required).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_REASON_MODEL=qwen3:4b
OLLAMA_RECOMMENDATION_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=embeddinggemma
OLLAMA_CHAT_THINK=true
OLLAMA_KEEP_ALIVE=5m
OLLAMA_TIMEOUT_SECONDS=300
