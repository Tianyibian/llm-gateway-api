{
  "info": {
    "name": "GraphRAG Guardrail — Live Model Checks",
    "description": "Real model scope/backend checks. Start Uvicorn first. No mocks, retrieval, graph writes, or conversation persistence. Model failures and semantic mismatches fail tests. The selected provider receives the server-owned scope/schema and test question.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Exact relationship selects Neo4j",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"Who supplies Philips Hue Smart Lock Max?\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/graphrag/guardrail",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "graphrag",
            "guardrail"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Assessment completed (not a provider failure)', () => pm.response.to.have.status(200));",
              "const result = pm.response.json();",
              "pm.test('Expected semantic decision: allow', () => pm.expect(result.action).to.eql('allow'));",
              "pm.test('Expected backend', () => pm.expect(result.backend).to.eql(\"neo4j\"));",
              "pm.test('Scope only: no retrieval or entity resolution claimed', () => {",
              "  pm.expect(result.retrieval_ready).to.eql(false);",
              "  pm.expect(result.entity_resolution).to.eql('not_performed');",
              "  pm.expect(result.policy_version).to.eql('aster-business-graph-v1');",
              "});"
            ]
          }
        }
      ]
    },
