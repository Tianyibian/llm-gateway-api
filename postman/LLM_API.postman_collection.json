      "name": "OpenAI",
      "item": [
        {
          "name": "1 - OpenAI Chat",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.text();",
                  "pm.test('HTTP status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response is SSE', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('text/event-stream'));",
                  "pm.test('Provider is OpenAI', () => pm.expect(body).to.include('\\\"provider\\\": \\\"openai\\\"'));",
                  "pm.test('Service is chat', () => pm.expect(body).to.include('\\\"service\\\": \\\"chat\\\"'));",
                  "pm.test('Stream has output', () => pm.expect(body).to.include('event: delta'));",
                  "pm.test('Stream completed', () => pm.expect(body).to.include('data: \\\"[DONE]\\\"'));",
                  "pm.test('Stream has no error event', () => pm.expect(body).to.not.include('event: error'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"provider-matrix-openai\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Reply with exactly: OpenAI chat test passed\"\n    }\n  ]\n}",
