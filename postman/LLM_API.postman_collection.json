        {
          "name": "6 - End-to-End Return RAG Route",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.text();",
                  "const answer = body.split(/\\r?\\n\\r?\\n/).filter(block => block.includes('event: delta')).map(block => { const line = block.split(/\\r?\\n/).find(item => item.startsWith('data: ')); return line ? JSON.parse(line.slice(6)).content : ''; }).join('');",
                  "pm.test('HTTP status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response is SSE', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('text/event-stream'));",
                  "pm.test('LangGraph selected policy_search', () => pm.expect(body).to.include('\\\"route\\\": \\\"policy_search\\\"'));",
                  "pm.test('RAG emitted document sources', () => { pm.expect(body).to.include('event: sources'); pm.expect(body).to.include('\\\"documents\\\"'); });",
                  "pm.test('Grounded answer includes a citation', () => pm.expect(answer).to.match(/\\[\\d+\\]/));",
                  "pm.test('Stream completed without an error', () => { pm.expect(body).to.include('data: \\\"[DONE]\\\"'); pm.expect(body).to.not.include('event: error'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"Can I return an installed smart lock, and how many days do I have?\",\n  \"user_id\": \"{{router_user_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{router_base_url}}/api/assistant",
            "description": "Runs the actual LangGraph route, pgvector retrieval, grounded generation, SSE stream, and conversation persistence through local Ollama."
          }
        }
