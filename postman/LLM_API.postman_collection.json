    {
      "name": "Stateful Conversation",
      "item": [
        {
          "name": "1 - Create Conversation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "pm.test('Conversation was created', () => pm.response.to.have.status(201));",
                  "pm.test('Response includes a conversation ID', () => pm.expect(data.id).to.be.a('string').and.not.empty);",
                  "if (pm.response.code === 201 && data.id) { pm.collectionVariables.set('conversation_id', data.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
