      "name": "Router - Live Model",
      "description": "Live Ollama tests for the five classifier routes plus one complete LangGraph RAG branch. No fake model is used.",
      "item": [
        {
          "name": "1 - General Search Classification",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "pm.test('HTTP status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response has the structured router schema', () => pm.expect(data).to.have.all.keys('route', 'reason', 'confidence'));",
                  "pm.test('Route is general_search', () => pm.expect(data.route).to.eql('general_search'));",
                  "pm.test('Reason is present', () => pm.expect(data.reason).to.be.a('string').and.not.empty);",
                  "pm.test('Confidence is between 0 and 1', () => pm.expect(data.confidence).to.be.within(0, 1));"
