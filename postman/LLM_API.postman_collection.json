            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{conversation_user_id}}\",\n  \"conversation_id\": \"{{conversation_id}}\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Remember that my preferred backend framework is FastAPI.\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{conversation_base_url}}/api/chat",
            "description": "Persist the first real LLM turn in the conversation."
          }
        },
        {
          "name": "3 - Second Turn Recalls History",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.text();",
                  "const assistantText = body.split(/\\r?\\n\\r?\\n/).filter(block => block.includes('event: delta')).map(block => { const line = block.split(/\\r?\\n/).find(item => item.startsWith('data: ')); return line ? JSON.parse(line.slice(6)).content : ''; }).join('');",
                  "pm.test('HTTP status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response is SSE', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('text/event-stream'));",
                  "pm.test('Assistant recalls FastAPI', () => pm.expect(assistantText.toLowerCase()).to.include('fastapi'));",
                  "pm.test('Stream completed', () => pm.expect(body).to.include('data: \"[DONE]\"'));",
                  "pm.test('Stream has no error event', () => pm.expect(body).to.not.include('event: error'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{conversation_user_id}}\",\n  \"conversation_id\": \"{{conversation_id}}\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Which backend framework did I tell you I prefer?\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{conversation_base_url}}/api/chat",
            "description": "Send only the new user turn; the server loads the first turn from the database."
          }
        },
        {
          "name": "4 - Verify Persisted Messages",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const messages = pm.response.json();",
                  "pm.test('HTTP status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Two complete turns were persisted', () => pm.expect(messages).to.have.length(4));",
                  "pm.test('Messages are ordered user/assistant/user/assistant', () => pm.expect(messages.map(item => item.role)).to.eql(['user', 'assistant', 'user', 'assistant']));",
                  "pm.test('Stored messages belong to this conversation', () => pm.expect(messages.every(item => item.conversation_id === pm.collectionVariables.get('conversation_id'))).to.be.true);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{conversation_base_url}}/api/conversations/{{conversation_id}}/messages?user_id={{conversation_user_id}}",
            "description": "Read both complete turns back from the database."
          }
        },
        {
