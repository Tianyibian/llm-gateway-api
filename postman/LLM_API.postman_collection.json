              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{conversation_base_url}}/api/conversations",
            "description": "Create a database-backed conversation and save its ID as a collection variable."
          }
        },
        {
          "name": "2 - First Turn",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.text();",
                  "pm.test('HTTP status is 200', () => pm.response.to.have.status(200));",
